<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.leasegate</groupId>
        <artifactId>gitgate-parent</artifactId>
        <version>0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>gitgate-app</artifactId>
    <packaging>jar</packaging>
    <description>The gitgate tray: the vault, the ssh agent, the token server and the approval windows.</description>
    <properties>
        <main.class>leasegate.gitgate.app.GitgateMain</main.class>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.github.leasegate</groupId>
            <artifactId>gitgate-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.leasegate</groupId>
            <artifactId>leasegate-ui</artifactId>
            <version>${leasegate.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.leasegate</groupId>
            <artifactId>leasegate-sshagent</artifactId>
            <version>${leasegate.version}</version>
        </dependency>
    </dependencies>
    <build>
        <finalName>gitgate</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                    <manifestEntries>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>jrexe</id>
            <activation><property><name>jrexe</name></property></activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.jarrunner</groupId>
                        <artifactId>jr-maven-plugin</artifactId>
                        <version>${jr.plugin.version}</version>
                        <executions>
                            <execution>
                                <goals><goal>exe</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <name>gitgate</name>
                            <icon>${project.basedir}/src/main/jr/gitgate.ico</icon>
                            <appId>io.github.leasegate:gitgate</appId>
                            <fileDescription>gitgate</fileDescription>
                            <productName>gitgate</productName>
                            <companyName>leasegate</companyName>
                            <copyright>leasegate contributors</copyright>
                            <javaVersion>25+</javaVersion>
                            <jvmMode>dll</jvmMode>
                            <!-- A tray that holds a few keys: small heap, Serial GC (smallest footprint, gives memory back), C1 only. -->
                            <vmArgs>
                                <vmArg>-Xms16m</vmArg>
                                <vmArg>-Xmx96m</vmArg>
                                <vmArg>-Xss512k</vmArg>
                                <vmArg>-XX:+UseSerialGC</vmArg>
                                <vmArg>-XX:MinHeapFreeRatio=10</vmArg>
                                <vmArg>-XX:MaxHeapFreeRatio=30</vmArg>
                                <vmArg>-XX:TieredStopAtLevel=1</vmArg>
                                <vmArg>-XX:MaxMetaspaceSize=96m</vmArg>
                                <vmArg>-XX:ReservedCodeCacheSize=32m</vmArg>
                                <vmArg>-XX:MaxDirectMemorySize=32m</vmArg>
                                <vmArg>--enable-native-access=ALL-UNNAMED</vmArg>
                            </vmArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
