<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.leasegate</groupId>
        <artifactId>gitgate-parent</artifactId>
        <version>0.2-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>gitgate-cli</artifactId>
    <name>gitgate cli: the git, gh and git1st launchers</name>
    <packaging>jar</packaging>
    <description>The git and gh proxies, the one-account aliases and git1st. No JavaFX, so they start fast.</description>
    <properties>
        <main.class>leasegate.gitgate.cli.Main</main.class>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.github.leasegate</groupId>
            <artifactId>gitgate-core</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
    <build>
        <finalName>gitgate-cli</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                    <manifestEntries>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <!-- The exes, jr launchers over this one jar; each knows its role from its own name, and an alias for
         one account is a copy named git<account> or gh<account> (gitgate aliases makes them):
         mvn -Djrexe -Djr.installDir=<folder on PATH> package -->
    <profiles>
        <profile>
            <id>jrexe</id>
            <activation><property><name>jrexe</name></property></activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.jarrunner</groupId>
                        <artifactId>jr-maven-plugin</artifactId>
                        <version>${jr.plugin.version}</version>
                        <configuration>
                            <javaVersion>25+</javaVersion>
                            <jvmMode>dll</jvmMode>
                            <companyName>leasegate</companyName>
                            <productName>gitgate</productName>
                            <copyright>leasegate contributors</copyright>
                            <!-- They live a fraction of a second: a small heap, the Serial collector, C1 only. -->
                            <vmArgs>
                                <vmArg>-Xms8m</vmArg>
                                <vmArg>-Xmx64m</vmArg>
                                <vmArg>-Xss512k</vmArg>
                                <vmArg>-XX:+UseSerialGC</vmArg>
                                <vmArg>-XX:TieredStopAtLevel=1</vmArg>
                                <vmArg>-XX:ReservedCodeCacheSize=24m</vmArg>
                                <vmArg>--enable-native-access=ALL-UNNAMED</vmArg>
                            </vmArgs>
                            <icon>${project.basedir}/src/main/jr/gitgate.ico</icon>
                        </configuration>
                        <executions>
                            <execution><id>gh</id><goals><goal>exe</goal></goals><configuration><name>gh</name><appId>io.github.leasegate:gitgate-gh</appId><fileDescription>gh through gitgate</fileDescription></configuration></execution>
                            <execution><id>git1st</id><goals><goal>exe</goal></goals><configuration><name>git1st</name><appId>io.github.leasegate:gitgate-git1st</appId><fileDescription>make this folder a GitHub repository</fileDescription></configuration></execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
